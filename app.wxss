/* 全局样式 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  color: #333;
  font-size: 28rpx;
}

view, text {
  box-sizing: border-box;
}

/* 通用主色按钮 */
.btn-primary {
  background: linear-gradient(90deg, #ff8a45, #ff6b35);
  color: #fff;
  border-radius: 40rpx;
  text-align: center;
}

/* 空状态提示 */
.empty-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 120rpx 0;
}
