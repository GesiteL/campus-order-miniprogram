/* 菜单页样式 */
page {
  height: 100vh;
}
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 顶部优惠栏 */
.promo-bar {
  flex-shrink: 0;
  height: 68rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  background: #fff7f2;
  color: #ff6b35;
  font-size: 24rpx;
}
.promo-tag {
  background: #ff6b35;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}

/* 主体区域 */
.main {
  flex: 1;
  min-height: 0;
  display: flex;
}

/* 左侧分类 */
.cate-list {
  width: 180rpx;
  height: 100%;
  background: #f5f5f5;
}
.cate-item {
  padding: 32rpx 16rpx;
  font-size: 26rpx;
  color: #555;
  text-align: center;
  position: relative;
}
.cate-item.active {
  background: #fff;
  color: #ff6b35;
  font-weight: 600;
}
.cate-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 36rpx;
  background: #ff6b35;
  border-radius: 4rpx;
}

/* 右侧菜品 */
.food-scroll {
  flex: 1;
  height: 100%;
  background: #fff;
}
.cate-section-title {
  padding: 20rpx 24rpx 8rpx;
  font-size: 26rpx;
  color: #999;
  font-weight: 600;
}
.food-item {
  display: flex;
  padding: 24rpx;
  border-bottom: 1rpx solid #f2f2f2;
}
.food-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #eee;
  flex-shrink: 0;
}
.food-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}
.food-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.food-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.food-meta {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 6rpx;
}
.food-bottom {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.food-price {
  color: #ff6b35;
  font-size: 32rpx;
  font-weight: 600;
}

/* 数量控制器样式已迁移至 components/stepper/stepper.wxss（改造新增） */

/* 底部购物车栏 */
.cart-bar {
  flex-shrink: 0;
  height: 100rpx;
  display: flex;
  align-items: center;
  background: #3a3a3a;
  position: relative;
  z-index: 20;
}
.cart-icon-wrap {
  position: relative;
  width: 110rpx;
  height: 110rpx;
  margin: -20rpx 0 0 24rpx;
  border-radius: 50%;
  background: #555;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cart-icon-wrap.active {
  background: #ff6b35;
}
.cart-icon {
  color: #fff;
  font-size: 40rpx;
}
.cart-badge {
  position: absolute;
  top: 0;
  right: 0;
  min-width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  padding: 0 6rpx;
  background: #f44;
  color: #fff;
  font-size: 22rpx;
  border-radius: 17rpx;
}
.cart-total {
  flex: 1;
  padding-left: 24rpx;
}
.cart-total-price {
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
}
.cart-total-empty {
  color: #999;
  font-size: 26rpx;
}
.cart-checkout {
  width: 200rpx;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background: #ff6b35;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}
.cart-checkout.disabled {
  background: #666;
  color: #aaa;
}

/* 购物车面板 */
.cart-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 100rpx;
  background: rgba(0, 0, 0, 0.5);
  z-index: 15;
}
.cart-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 100rpx;
  background: #fff;
  z-index: 16;
  border-radius: 20rpx 20rpx 0 0;
  transform: translateY(120%);
  transition: transform 0.25s ease;
  max-height: 60vh;
  display: flex;
  flex-direction: column;
}
.cart-panel.show {
  transform: translateY(0);
}
.cart-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #f2f2f2;
}
.cart-panel-title {
  font-size: 28rpx;
  font-weight: 600;
}
.cart-clear {
  font-size: 26rpx;
  color: #999;
}
.cart-panel-list {
  max-height: 46vh;
  padding: 0 24rpx;
}
.cart-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f7f7f7;
}
.cart-row-name {
  font-size: 28rpx;
  color: #333;
}
.cart-row-right {
  display: flex;
  align-items: center;
}
.cart-row-price {
  color: #ff6b35;
  font-size: 28rpx;
  margin-right: 20rpx;
}

/* ==================== 自定义菜品（改造新增） ==================== */

/* 左侧分类栏底部入口 */
.cate-add {
  padding: 32rpx 16rpx;
  font-size: 26rpx;
  color: #ff6b35;
  text-align: center;
  border-top: 1rpx solid #e8e8e8;
}

/* 自定义菜品角标与提示 */
.custom-tag {
  display: inline-block;
  font-size: 18rpx;
  font-weight: 400;
  color: #ff6b35;
  border: 1rpx solid #ff6b35;
  border-radius: 6rpx;
  padding: 0 8rpx;
  margin-left: 10rpx;
  vertical-align: middle;
}
.custom-hint {
  color: #ff6b35;
}

/* 自定义菜品弹层 */
.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 30;
}
.modal-panel {
  position: fixed;
  left: 60rpx;
  right: 60rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  z-index: 31;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}
.modal-input {
  height: 80rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}
.modal-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}
.modal-btn {
  width: 45%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 30rpx;
}
.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
}
.modal-btn.ok {
  background: #ff6b35;
  color: #fff;
}

/* 搜索栏（改造新增） */
.search-bar {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  background: #fff;
}
.search-input {
  height: 64rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}
