/* 订单列表页样式 */
.order-list {
  padding: 24rpx;
}
.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.order-food {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.order-state {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.order-state.wait {
  background: #fff0e8;
  color: #ff6b35;
}
.order-state.taken {
  background: #eef7ee;
  color: #52a852;
}
.order-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}
.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.order-time {
  font-size: 24rpx;
  color: #bbb;
}
.order-money {
  color: #ff6b35;
  font-size: 32rpx;
  font-weight: 600;
}
.load-tip {
  text-align: center;
  color: #bbb;
  font-size: 24rpx;
  padding: 24rpx 0;
}
