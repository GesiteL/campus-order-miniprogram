<!-- 订单详情页 -->
<view class="detail" wx:if="{{order}}">

  <!-- 取餐号 -->
  <view class="pickup">
    <view class="pickup-label">取餐号</view>
    <view class="pickup-num">{{order.meunnumber}}</view>
    <view class="pickup-status {{order.taken ? 'taken' : ''}}">
      {{order.taken ? '已取餐' : '待取餐'}}
    </view>
  </view>

  <!-- 商品清单 -->
  <view class="card">
    <view class="card-title">商品清单</view>
    <view class="goods-item" wx:for="{{order.foods}}" wx:key="name">
      <text class="goods-name">{{item.name}}</text>
      <view class="goods-right">
        <text class="goods-price">¥{{item.price}}</text>
        <text class="goods-num">x{{item.num}}</text>
      </view>
    </view>

    <view class="promotion" wx:if="{{order.promotion}}">
      <text>{{order.promotion.name}}</text>
      <text class="promotion-cut">-¥{{order.promotion.discount}}</text>
    </view>

    <view class="goods-total">
      <text>合计</text>
      <text class="total-price">¥{{total}}</text>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="card">
    <view class="card-title">订单信息</view>
    <view class="info-row">
      <text class="info-label">订单编号</text>
      <text class="info-value">{{order.ordernum}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">下单时间</text>
      <text class="info-value">{{order.ordertime}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">订单状态</text>
      <text class="info-value">{{order.taken ? '已取餐' : '待取餐'}}</text>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="detail-btns">
    <view class="detail-btn ghost" bindtap="goHome">回到首页</view>
    <view class="detail-btn primary" bindtap="goOrders">查看订单</view>
  </view>
</view>
