/* 订单详情页样式 */
.detail {
  padding: 24rpx 24rpx 140rpx;
}

/* 取餐号 */
.pickup {
  background: linear-gradient(135deg, #ff8a45, #ff6b35);
  border-radius: 16rpx;
  padding: 40rpx;
  text-align: center;
  color: #fff;
  margin-bottom: 24rpx;
}
.pickup-label {
  font-size: 26rpx;
  opacity: 0.9;
}
.pickup-num {
  font-size: 80rpx;
  font-weight: 700;
  margin: 12rpx 0;
}
.pickup-status {
  display: inline-block;
  padding: 6rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.25);
  font-size: 26rpx;
}
.pickup-status.taken {
  background: rgba(255, 255, 255, 0.9);
  color: #ff6b35;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.goods-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.goods-name {
  font-size: 28rpx;
  color: #333;
}
.goods-right {
  display: flex;
  align-items: center;
}
.goods-price {
  color: #ff6b35;
  font-size: 28rpx;
  margin-right: 20rpx;
}
.goods-num {
  color: #999;
  font-size: 26rpx;
}
.promotion {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #666;
}
.promotion-cut {
  color: #ff6b35;
}
.goods-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
  font-size: 28rpx;
}
.total-price {
  color: #ff6b35;
  font-size: 34rpx;
  font-weight: 600;
}
.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 26rpx;
}
.info-label {
  color: #999;
}
.info-value {
  color: #333;
}
.detail-btns {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
}
.detail-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  font-size: 30rpx;
}
.detail-btn.ghost {
  background: #fff;
  color: #ff6b35;
  border: 1rpx solid #ff6b35;
}
.detail-btn.primary {
  background: linear-gradient(90deg, #ff8a45, #ff6b35);
  color: #fff;
}
