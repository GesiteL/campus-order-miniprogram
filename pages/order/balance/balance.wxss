/* 订单确认页样式 */
.balance {
  padding: 24rpx 24rpx 140rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.order-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.order-name {
  font-size: 28rpx;
  color: #333;
}
.order-right {
  display: flex;
  align-items: center;
}
.order-price {
  color: #ff6b35;
  font-size: 28rpx;
  margin-right: 20rpx;
}
.order-num {
  color: #999;
  font-size: 26rpx;
}
.order-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  font-size: 28rpx;
  color: #666;
}
.total-price {
  color: #ff6b35;
  font-size: 34rpx;
  font-weight: 600;
}
.remark {
  width: 100%;
  height: 140rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}
.submit-total {
  font-size: 28rpx;
  color: #333;
}
.submit-btn {
  width: 240rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  background: linear-gradient(90deg, #ff8a45, #ff6b35);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 38rpx;
}
