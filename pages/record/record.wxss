/* 消费记录页样式 */
.record {
  padding-bottom: 40rpx;
}

/* 个人信息 */
.profile {
  background: linear-gradient(135deg, #ff8a45, #ff6b35);
  padding: 48rpx 32rpx;
  display: flex;
  align-items: center;
  color: #fff;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  background: #eee;
}
.profile-info {
  margin-left: 24rpx;
}
.nickname {
  font-size: 34rpx;
  font-weight: 600;
}
.total-label {
  font-size: 26rpx;
  margin-top: 12rpx;
  opacity: 0.95;
}
.total-money {
  font-size: 34rpx;
  font-weight: 700;
}

.section-title {
  padding: 24rpx 24rpx 8rpx;
  font-size: 28rpx;
  color: #999;
}
.record-list {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.record-title {
  font-size: 28rpx;
  color: #333;
}
.record-time {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 8rpx;
}
.record-money {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff6b35;
}
